# A plain local preview needs none of these: run python app.py seed, then python app.py.
# Vercel (Production and a SEPARATE staging project/database for Preview):
PREVIEW=0
COOKIE_SECURE=1
# Supabase Connect > Transaction pooler URI. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Project Settings > API (server-side secrets only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_IN_VERCEL
SUPABASE_STORAGE_BUCKET=product-images
# Generate a strong random value; never use this placeholder.
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
