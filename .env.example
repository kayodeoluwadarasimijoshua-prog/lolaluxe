# Plain local preview requires none of these; see README.md.
# Recommended Vercel setup: Neon PostgreSQL + Cloudinary photos.
PREVIEW=0
COOKIE_SECURE=1
DATABASE_URL=postgresql://NEON_USER:URL_ENCODED_PASSWORD@NEON_POOLER_HOST/neondb?sslmode=require
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=SET_PRIVATELY_IN_VERCEL
CLOUDINARY_API_SECRET=SET_PRIVATELY_IN_VERCEL
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Previous Supabase photo storage remains supported if Cloudinary is not configured.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_IN_VERCEL
# SUPABASE_STORAGE_BUCKET=product-images
